<mjml>
  <mj-head>
    <mj-title>Mitsubishi Elevator Asia Co., Ltd. (AMEC) — Reset Password</mj-title>
    <mj-preview>คำขอตั้งรหัสผ่านใหม่สำหรับระบบคู่ค้า Mitsubishi Elevator Asia Co., Ltd. (AMEC) Supplier Portal</mj-preview>
    <mj-font name="Roboto" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Roboto, 'Noto Sans Thai', 'Helvetica Neue', Arial, sans-serif" color="#333333" />
      <mj-text font-size="14px" line-height="160%" />
    </mj-attributes>
    <mj-style>
      .badge-text { font-family: monospace; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
      .meta-label { font-size: 10px; font-weight: 700; color: #636363; text-transform: uppercase; letter-spacing: 0.05em; }
      .meta-val { font-size: 13px; font-weight: 700; color: #000000; font-family: monospace; margin-top: 4px; }
      .meta-sub { font-size: 11px; color: #636363; margin-top: 2px; }
      .card-border { border-left: 4px solid #000000; border-top: 1px solid #e6e6e6; border-right: 1px solid #e6e6e6; border-bottom: 1px solid #e6e6e6; }
      .pillar-card { background-color: #ffffff; border: 1px solid #e6e6e6; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f4f5f7" width="800px">
    <!-- Outer Wrapper -->
    <mj-wrapper padding="24px 12px">
      <!-- Container 640px -->
      
      <!-- Top Corporate Red Accent Bar -->
      <mj-section background-color="#c40001" padding="0">
        <mj-column padding="0">
          <mj-divider border-width="4px" border-color="#c40001" padding="0" />
        </mj-column>
      </mj-section>

      <!-- Header: Brand Identity -->
      <mj-section background-color="#ffffff" padding="20px 32px" border-left="1px solid #e6e6e6" border-right="1px solid #e6e6e6" border-bottom="1px solid #e6e6e6">
        <mj-column width="70%" vertical-align="middle">
          <mj-table padding="0">
            <tr>
              <td style="vertical-align: middle; padding-right: 16px; width: 140px; border-right: 1px solid #e6e6e6;">
                <img src="cid:brand-logo" alt="Mitsubishi Electric - Changes for the Better" width="135" style="display: block; width: 135px; max-width: 135px; height: auto;" />
              </td>
              <td style="vertical-align: middle; padding-left: 16px;">
                <div style="font-size: 13px; font-weight: 700; color: #000000; line-height: 1.3;">
                  Mitsubishi Elevator Asia Co., Ltd.
                </div>
                <div style="font-size: 11px; color: #636363; text-transform: uppercase; letter-spacing: 0.06em; margin-top: 2px;">
                  Supplier Portal (AMEC)
                </div>
              </td>
            </tr>
          </mj-table>
        </mj-column>
        <mj-column width="30%" vertical-align="middle">
          <mj-text align="right" padding="0">
            <span style="display: inline-block; background-color: #f2f2f2; color: #000000; font-family: monospace; font-size: 11px; font-weight: 700; padding: 5px 8px; text-transform: uppercase; letter-spacing: 0.05em;">
              AUTH // SECURITY
            </span>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Hero Statement -->
      <mj-section background-color="#ffffff" padding="32px 32px 24px 32px" border-left="1px solid #e6e6e6" border-right="1px solid #e6e6e6">
        <mj-column padding="0">
          <!-- Eyebrow Badge -->
          <mj-text padding="0 0 14px 0">
            <span style="background-color: #f2f2f2; padding: 6px 10px; display: inline-block;">
              <span style="display: inline-block; width: 6px; height: 6px; background-color: #c40001; margin-right: 8px; vertical-align: middle;"></span>
              <span style="font-size: 11px; font-weight: 700; color: #000000; text-transform: uppercase; letter-spacing: 0.08em; vertical-align: middle;">Account Security Notification</span>
            </span>
          </mj-text>

          <!-- Headline -->
          <mj-text font-size="22px" font-weight="500" color="#000000" line-height="130%" padding="0 0 8px 0">
            คำขอรีเซ็ตรหัสผ่าน (Password Reset Request)
          </mj-text>
          <mj-text font-size="13px" color="#636363" line-height="150%" padding="0 0 18px 0">
            แจ้งเตือนการตั้งรหัสผ่านใหม่สำหรับเข้าใช้งานระบบ Mitsubishi Elevator Asia (AMEC) Supplier Portal
          </mj-text>

          <!-- Greeting & Intro -->
          <mj-text font-size="14px" color="#333333" line-height="165%" padding="0 0 12px 0">
            เรียนคุณ <strong style="color: #000000;">{{RECIPIENT_NAME}}</strong>,
          </mj-text>
          <mj-text font-size="14px" color="#333333" line-height="165%" padding="0">
            ระบบได้รับคำขอสำหรับการตั้งรหัสผ่านใหม่ของบัญชีผู้ใช้งานของคุณ หากคุณเป็นผู้ส่งคำขอนี้ กรุณาคลิกปุ่มด้านล่างเพื่อดำเนินการตั้งรหัสผ่านใหม่
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Micro Metas Bar -->
      <mj-section background-color="#ffffff" padding="20px 32px 28px 32px" border-left="1px solid #e6e6e6" border-right="1px solid #e6e6e6">
        <mj-column width="33%" padding="8px 0">
          <mj-text padding="0">
            <div class="meta-label">Username</div>
            <div class="meta-val">{{USERNAME}}</div>
            <div class="meta-sub">Account Login ID</div>
          </mj-text>
        </mj-column>
        <mj-column width="33%" padding="8px 0">
          <mj-text padding="0">
            <div class="meta-label">Validity Period</div>
            <div style="font-size: 13px; font-weight: 700; color: #c40001; margin-top: 4px;">{{EXPIRES_IN}}</div>
            <div class="meta-sub">Link Lifetime</div>
          </mj-text>
        </mj-column>
        <mj-column width="34%" padding="8px 0">
          <mj-text padding="0">
            <div class="meta-label">Requested At</div>
            <div class="meta-val">{{REQUEST_TIME}}</div>
            <div class="meta-sub">ICT (Bangkok Time)</div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Action Card & CTA -->
      <mj-section background-color="#f4f5f7" padding="28px 32px" border-left="1px solid #e6e6e6" border-right="1px solid #e6e6e6" border-top="1px solid #e6e6e6">
        <mj-column background-color="#ffffff" padding="20px 24px" css-class="card-border">
          <mj-text padding="0 0 6px 0" font-size="11px" font-weight="700" color="#c40001" letter-spacing="0.88px">
            SECURITY ACTION REQUIRED
          </mj-text>
          <mj-text padding="0 0 10px 0" font-size="14px" font-weight="500" color="#000000" line-height="155%">
            กรุณากดปุ่มเพื่อตั้งรหัสผ่านใหม่ก่อนลิงก์หมดอายุ
          </mj-text>
          <mj-text padding="0 0 20px 0" font-size="13px" color="#636363" line-height="160%">
            เพื่อความปลอดภัยของข้อมูลในระบบ ลิงก์นี้จะสามารถใช้งานได้เพียงครั้งเดียว (One-Time Use) และจะหมดอายุการใช้งานภายใน <strong>{{EXPIRES_IN}}</strong> นับจากเวลาที่ส่งคำขอ
          </mj-text>

          <mj-button href="{{RESET_LINK}}" background-color="#000000" color="#ffffff" font-size="12px" font-weight="700" border-radius="0px" inner-padding="12px 28px" align="left" padding="0">
            <span style="letter-spacing: 0.96px;">ตั้งรหัสผ่านใหม่ (Reset Password) &rarr;</span>
          </mj-button>

          <mj-text padding="18px 0 0 0" font-size="12px" color="#636363" line-height="160%">
            หากไม่สามารถกดปุ่มด้านบนได้ สามารถคัดลอกลิงก์ด้านล่างไปวางในเว็บเบราว์เซอร์ได้โดยตรง:<br />
            <a href="{{RESET_LINK}}" style="color: #000000; font-family: monospace; font-size: 11px; word-break: break-all; text-decoration: underline;">{{RESET_LINK}}</a>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Security Guidance Rules -->
      <mj-section background-color="#ffffff" padding="28px 32px" border-left="1px solid #e6e6e6" border-right="1px solid #e6e6e6" border-top="1px solid #e6e6e6">
        <mj-column width="100%">
          <mj-text padding="0 0 4px 0" font-size="11px" font-weight="700" color="#c40001" letter-spacing="1.1px">
            SECURITY GUIDANCE
          </mj-text>
          <mj-text padding="0 0 18px 0" font-size="16px" font-weight="500" color="#000000">
            คำแนะนำและข้อควรระวังเพื่อความปลอดภัย
          </mj-text>
        </mj-column>
        <mj-column width="32%" background-color="#ffffff" padding="14px" border-top="2px solid #000000" border="1px solid #e6e6e6">
          <mj-text padding="0 0 8px 0">
            <span style="background-color: #000000; color: #ffffff; font-size: 10px; font-weight: 700; padding: 2px 6px;">RULE 01</span>
          </mj-text>
          <mj-text padding="0 0 4px 0" font-size="13px" font-weight="700" color="#000000">
            ไม่ได้ส่งคำขอนี้?
          </mj-text>
          <mj-text padding="0" font-size="12px" color="#636363" line-height="150%">
            หากคุณไม่ได้เป็นผู้ทำรายการ โปรดละเว้นอีเมลฉบับนี้ รหัสผ่านเดิมของคุณยังคงปลอดภัย
          </mj-text>
        </mj-column>
        <mj-column width="2%"></mj-column>
        <mj-column width="32%" background-color="#ffffff" padding="14px" border-top="2px solid #c40001" border="1px solid #e6e6e6">
          <mj-text padding="0 0 8px 0">
            <span style="background-color: #c40001; color: #ffffff; font-size: 10px; font-weight: 700; padding: 2px 6px;">RULE 02</span>
          </mj-text>
          <mj-text padding="0 0 4px 0" font-size="13px" font-weight="700" color="#000000">
            ความปลอดภัยรหัสผ่าน
          </mj-text>
          <mj-text padding="0" font-size="12px" color="#636363" line-height="150%">
            กำหนดรหัสผ่านอย่างน้อย 6 ตัวอักษรขึ้นไป และไม่ควรซ้ำกับรหัสผ่านเดิม
          </mj-text>
        </mj-column>
        <mj-column width="2%"></mj-column>
        <mj-column width="32%" background-color="#ffffff" padding="14px" border-top="2px solid #000000" border="1px solid #e6e6e6">
          <mj-text padding="0 0 8px 0">
            <span style="background-color: #000000; color: #ffffff; font-size: 10px; font-weight: 700; padding: 2px 6px;">RULE 03</span>
          </mj-text>
          <mj-text padding="0 0 4px 0" font-size="13px" font-weight="700" color="#000000">
            ห้ามเปิดเผยข้อมูล
          </mj-text>
          <mj-text padding="0" font-size="12px" color="#636363" line-height="150%">
            เจ้าหน้าที่ AMEC จะไม่ขอรหัสผ่านหรือข้อมูลส่วนตัวของคุณผ่านทางอีเมลหรือโทรศัพท์
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Security Notice Banner -->
      <mj-section background-color="#000000" padding="20px 32px">
        <mj-column padding="0">
          <mj-text padding="0 0 6px 0" font-size="11px" font-weight="700" color="#ffffff" letter-spacing="0.88px">
            SECURITY &amp; CONFIDENTIALITY NOTICE (CLASSIFICATION LEVEL 2)
          </mj-text>
          <mj-text padding="0" font-size="12px" color="#e6e6e6" line-height="160%">
            This is an automated message from the <strong style="color: #ffffff;">AMEC Supplier Portal</strong>. Please do not reply directly to this e-mail.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer -->
      <mj-section background-color="#dbdbdb" padding="28px 32px" border-top="1px solid #000000">
        <mj-column width="50%" padding-right="16px">
          <mj-text padding="0 0 6px 0" font-size="11px" font-weight="700" color="#000000" letter-spacing="0.66px">
            MITSUBISHI ELEVATOR ASIA CO., LTD.
          </mj-text>
          <mj-text padding="0 0 16px 0" font-size="12px" color="#4d4d4d" line-height="155%">
            700/86 Amata City Chonburi Industrial Estate Moo 6, Tambon Don Hua Roh, Amphur Muang, Chonburi 20000, Thailand
          </mj-text>
        </mj-column>
        <mj-column width="50%">
          <mj-text padding="0 0 6px 0" font-size="11px" font-weight="700" color="#000000" letter-spacing="0.66px">
            HELPDESK &amp; SUPPORT
          </mj-text>
          <mj-text padding="0 0 16px 0" font-size="12px" color="#000000" line-height="155%">
            Procurement Service Center<br />
            <strong>+66-38-936-600 / ext. 1310 - 1359</strong><br />
            <span style="color: #4d4d4d;">Mon - Fri: 08:30 - 17:30 ICT</span>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Legal Utility Bar -->
      <mj-section background-color="#dbdbdb" padding="0 32px 24px 32px">
        <mj-column width="50%">
          <mj-text padding="0" font-size="11px" color="#4d4d4d">
            &copy; Mitsubishi Electric Corporation. All Rights Reserved.
          </mj-text>
        </mj-column>
        <mj-column width="50%">
          <mj-text padding="0" font-size="11px" color="#4d4d4d" align="right">
            <a href="https://th.mitsubishielectric.com/en/privacy/" style="color: #333333; text-decoration: none;">Privacy Policy</a>
            &nbsp;|&nbsp;
            <a href="https://th.mitsubishielectric.com/en/terms/" style="color: #333333; text-decoration: none;">Terms of Use</a>
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>
  </mj-body>
</mjml>
